<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <queries>
        <package android:name="com.instagram.android" />
    </queries>

    <application
        android:name=".InstaTools"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/new_backup"
        android:fullBackupContent="@xml/old_backup"
        android:icon="@mipmap/launcher"
        android:label="@string/app_name"
        android:manageSpaceActivity="ir.mahdiparastesh.instatools.Settings"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstaTools">

        <activity
            android:name=".Main"
            android:exported="true"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Login"
            android:exported="false"
            android:theme="@style/Theme.InstaTools.Secondary"
            android:windowSoftInputMode="stateHidden|adjustPan" />

        <activity
            android:name=".Downloads"
            android:exported="true"
            android:launchMode="singleTask"
            android:parentActivityName=".Main"
            android:theme="@style/Theme.InstaTools.Secondary">

            <intent-filter android:label="@string/dwShare">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Viewer"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.InstaTools.Secondary">

            <intent-filter
                android:autoVerify="false"
                android:label="@string/vwShare">

                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />

                <data android:host="instagram.com" />
                <data android:host="www.instagram.com" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Settings"
            android:exported="true"
            android:parentActivityName=".Main"
            android:theme="@style/Theme.InstaTools.Tertiary" />

        <service
            android:name=".job.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <service
            android:name=".job.CommandService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
    </application>
</manifest>