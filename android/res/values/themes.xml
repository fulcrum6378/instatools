<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.InstaTools.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/defCA</item>
        <item name="colorPrimaryDark">?attr/colorPrimary</item>
        <item name="colorPrimaryWeak">@color/CSW</item>
        <item name="colorPrimaryHigh">@color/CSH</item>

        <item name="android:windowBackground">?attr/backgroundColor</item>
        <item name="android:navigationBarColor">?attr/backgroundColor</item>
        <item name="android:statusBarColor">?attr/backgroundColor</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">
            @drawable/logo_splash
        </item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/defBG</item>

        <!-- texts -->
        <item name="android:editTextColor">?attr/colorAccent</item>
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:textAppearance">@style/TextAppearance.InstaTools.Light</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.InstaTools.Medium</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.InstaTools.Medium</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.InstaTools.Medium</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textColorHint">?attr/colorPrimaryHigh</item>
        <item name="android:titleTextColor">?attr/colorAccent</item>

        <!-- components -->
        <item name="android:checkboxStyle">@style/Theme.InstaTools.Checkbox</item>
        <item name="android:radioButtonStyle">@style/Theme.InstaTools.Radio</item>
        <item name="switchStyle">@style/Theme.InstaTools.Switch</item>
        <item name="android:popupTheme">@style/Theme.InstaTools.Popup.Secondary</item>
        <!-- if you add overflow menu for PageUnf or PageBox; you're gonna have trouble with this! -->
        <!--<item name="android:searchViewStyle">@style/Theme.InstaTools.SearchView</item>-->
    </style>

    <style name="Theme.InstaTools" parent="Theme.InstaTools.Base">
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="backgroundColor">@color/defBG</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:itemBackground">@drawable/menu_item</item>
    </style>

    <style name="Theme.InstaTools.Primary" parent="Theme.InstaTools">
        <item name="colorPrimary">@color/CP</item>
        <item name="colorPrimaryWeak">@color/CPW</item>
        <item name="colorPrimaryHigh">@color/CPH</item>
        <item name="android:alertDialogTheme">@style/Theme.InstaTools.Dialog.Primary</item>
    </style>

    <style name="Theme.InstaTools.Secondary" parent="Theme.InstaTools">
        <item name="colorPrimary">@color/CS</item>
        <item name="colorPrimaryWeak">@color/CSW</item>
        <item name="colorPrimaryHigh">@color/CSH</item>
        <item name="android:alertDialogTheme">@style/Theme.InstaTools.Dialog.Secondary</item>
    </style>

    <style name="Theme.InstaTools.Tertiary" parent="Theme.InstaTools">
        <item name="colorPrimary">@color/CT</item>
        <item name="colorPrimaryWeak">@color/CTW</item>
        <item name="colorPrimaryHigh">@color/CTH</item>
        <item name="defCA">@color/defCA</item>
        <item name="android:alertDialogTheme">@style/Theme.InstaTools.Dialog.Tertiary</item>
    </style>

    <attr name="colorPrimaryWeak" format="reference|color" />
    <attr name="colorPrimaryHigh" format="reference|color" />
    <attr name="defCA" format="reference|color" />


    <!-- PopupMenu -->
    <style name="Theme.InstaTools.Popup" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="Theme.InstaTools.Popup.Primary" parent="Theme.InstaTools.Popup">
        <item name="colorPrimary">@color/CP</item>
        <item name="colorPrimaryWeak">@color/CPW</item>
    </style>

    <style name="Theme.InstaTools.Popup.Secondary" parent="Theme.InstaTools.Popup">
        <item name="colorPrimary">@color/CS</item>
        <item name="colorPrimaryWeak">@color/CSW</item>
    </style>

    <style name="Theme.InstaTools.Popup.Tertiary" parent="Theme.InstaTools.Popup">
        <item name="colorPrimary">@color/CT</item>
        <item name="colorPrimaryWeak">@color/CTW</item>
    </style>


    <!-- AlertDialog -->
    <style name="Theme.InstaTools.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <!--TODO apply a light font on body texts -->
    </style>

    <!--<style name="Theme.InstaTools.Dialog.Primary" parent="Theme.InstaTools.Dialog">
        <item name="colorPrimary">@color/CP</item>&lt;!&ndash; buttons &ndash;&gt;
    </style>

    <style name="Theme.InstaTools.Dialog.Secondary" parent="Theme.InstaTools.Dialog">
        <item name="colorPrimary">@color/CS</item>
    </style>

    <style name="Theme.InstaTools.Dialog.Tertiary" parent="Theme.InstaTools.Dialog">
        <item name="colorPrimary">@color/CT</item>
    </style>-->


    <!-- miscellaneous -->
    <style name="Theme.InstaTools.Checkbox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="buttonTint">?attr/colorAccent</item>
    </style>

    <style name="Theme.InstaTools.Radio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="buttonTint">?attr/colorAccent</item>
    </style>

    <style name="Theme.InstaTools.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:fontFamily">@font/light</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Theme.InstaTools.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:textColor">?attr/colorAccent</item>
    </style>

    <style name="Theme.InstaTools.BNV" parent="Theme.MaterialComponents.DayNight" />
    <!-- don't use Widget.MaterialComponents -->
</resources>