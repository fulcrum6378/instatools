<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.InstaTools.Base" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:colorPrimary">@color/defCA</item>
        <item name="android:colorPrimaryDark">?android:colorPrimary</item>
        <item name="colorPrimaryWeak">@color/CSW</item>
        <item name="colorPrimaryHigh">@color/CSH</item>

        <item name="android:windowBackground">?backgroundColor</item>
        <item name="android:navigationBarColor">?backgroundColor</item>
        <item name="android:statusBarColor">?backgroundColor</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">
            @drawable/logo_splash
        </item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/defBG</item>

        <!-- texts -->
        <item name="android:editTextColor">?android:colorAccent</item>
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:textAppearance">@style/TextAppearance.InstaTools.Light</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.InstaTools.Medium</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.InstaTools.Light</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.InstaTools.Light</item>
        <item name="android:textColor">?android:colorAccent</item>
        <item name="android:textColorHint">?colorPrimaryHigh</item>
        <item name="android:titleTextColor">?android:colorAccent</item>

        <!-- material -->
        <item name="drawerArrowStyle">@style/Widget.InstaTools.DrawerArrowToggle</item>
    </style>

    <style name="Theme.InstaTools" parent="Theme.InstaTools.Base">
        <item name="android:colorAccent">?android:colorPrimary</item>
        <item name="backgroundColor">@color/defBG</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:itemBackground">@drawable/menu_item</item>
    </style>

    <style name="Theme.InstaTools.Primary" parent="Theme.InstaTools">
        <item name="android:colorPrimary">@color/CP</item>
        <item name="colorPrimaryWeak">@color/CPW</item>
        <item name="colorPrimaryHigh">@color/CPH</item>
    </style>

    <style name="Theme.InstaTools.Secondary" parent="Theme.InstaTools">
        <item name="android:colorPrimary">@color/CS</item>
        <item name="colorPrimaryWeak">@color/CSW</item>
        <item name="colorPrimaryHigh">@color/CSH</item>
    </style>

    <style name="Theme.InstaTools.Tertiary" parent="Theme.InstaTools">
        <item name="android:colorPrimary">@color/CT</item>
        <item name="colorPrimaryWeak">@color/CTW</item>
        <item name="colorPrimaryHigh">@color/CTH</item>
        <item name="defCA">@color/defCA</item>
    </style>

    <attr name="colorPrimaryWeak" format="reference|color" />
    <attr name="colorPrimaryHigh" format="reference|color" />
    <attr name="defCA" format="reference|color" />


    <!-- PopupMenu -->
    <style name="Widget.InstaTools.Popup" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:textColor">?android:colorPrimary</item>
    </style>

    <style name="Widget.InstaTools.Popup.Primary" parent="Widget.InstaTools.Popup">
        <item name="android:colorPrimary">@color/CP</item>
        <item name="colorPrimaryWeak">@color/CPW</item>
    </style>

    <style name="Widget.InstaTools.Popup.Secondary" parent="Widget.InstaTools.Popup">
        <item name="android:colorPrimary">@color/CS</item>
        <item name="colorPrimaryWeak">@color/CSW</item>
    </style>

    <style name="Widget.InstaTools.Popup.Tertiary" parent="Widget.InstaTools.Popup">
        <item name="android:colorPrimary">@color/CT</item>
        <item name="colorPrimaryWeak">@color/CTW</item>
    </style>


    <!-- material -->
    <declare-styleable name="DrawerArrowToggle">
        <!-- The drawing color for the bars -->
        <attr name="color" format="color" />
        <!-- Whether bars should rotate or not during transition -->
        <attr name="spinBars" format="boolean" />
        <!-- The total size of the drawable -->
        <attr name="drawableSize" format="dimension" />
        <!-- The max gap between the bars when they are parallel to each other -->
        <attr name="gapBetweenBars" format="dimension" />
        <!-- The length of the arrow head when formed to make an arrow -->
        <attr name="arrowHeadLength" format="dimension" />
        <!-- The length of the shaft when formed to make an arrow -->
        <attr name="arrowShaftLength" format="dimension" />
        <!-- The length of the bars when they are parallel to each other -->
        <attr name="barLength" format="dimension" />
        <!-- The thickness (stroke size) for the bar paint -->
        <attr name="thickness" format="dimension" />
    </declare-styleable>

    <attr name="drawerArrowStyle" format="reference" />

    <style name="Widget.InstaTools.DrawerArrowToggle.Base">
        <item name="color">?android:attr/textColorSecondary</item>
        <item name="spinBars">true</item>
        <item name="thickness">2dp</item>
        <item name="arrowShaftLength">16dp</item>
        <item name="arrowHeadLength">8dp</item>
    </style>

    <style name="Widget.InstaTools.DrawerArrowToggle" parent="Widget.InstaTools.DrawerArrowToggle.Base">
        <item name="barLength">18dp</item>
        <item name="gapBetweenBars">3dp</item>
        <item name="drawableSize">24dp</item>
    </style>

