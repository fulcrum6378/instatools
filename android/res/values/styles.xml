<resources>

    <!-- #TextAppearance -->
    <style name="TextAppearance.InstaTools.Bold" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/bold</item>
    </style>

    <style name="TextAppearance.InstaTools.Medium" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/medium</item>
    </style>

    <style name="TextAppearance.InstaTools.Light" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/light</item>
    </style>

    <style name="TextAppearance.InstaTools.Toolbar" parent="@style/TextAppearance.InstaTools.Bold">
        <item name="android:textSize">@dimen/tbTitle</item>
    </style>

    <style name="TextAppearance.InstaTools.Toolbar.Main" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/logo</item>
        <item name="android:textSize">@dimen/tbTitleMain</item>
    </style>

    <style name="TextAppearance.InstaTools.BNV.Active" parent="@style/TextAppearance.InstaTools.Bold">
        <item name="android:textColor">?android:textColor</item>
        <item name="android:textSize">@dimen/bnvTextActive</item>
    </style>

    <style name="TextAppearance.InstaTools.BNV.Inactive" parent="@style/TextAppearance.InstaTools.Medium">
        <item name="android:textColor">?android:textColor</item>
        <item name="android:textSize">@dimen/bnvTextInactive</item>
    </style>

    <style name="TextAppearance.InstaTools.Search" parent="@style/TextAppearance.InstaTools.Medium">
        <item name="android:textColor">?android:textColor</item>
        <item name="android:textSize">@dimen/searchText</item>
    </style>

    <style name="TextAppearance.InstaTools.Switch" parent="@style/TextAppearance.InstaTools.Medium">
        <item name="android:textColor">?android:textColor</item>
    </style>


    <!-- #Global -->
    <style name="root">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layoutDirection">locale</item>
    </style>

    <style name="parentConstraint">
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
    </style>

    <style name="toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?android:actionBarSize</item>
        <item name="android:titleTextAppearance">@style/TextAppearance.InstaTools.Toolbar</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>

    <style name="searchView" />

    <style name="sep">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:alpha">0.12</item>
        <item name="android:background">?android:colorAccent</item>
    </style>

    <style name="shadow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:alpha">0.6</item>
        <item name="android:background">@drawable/shadow</item>
    </style>

    <style name="tbShadow" parent="shadow">
        <item name="android:visibility">invisible</item>
        <item name="layout_constraintTop_toBottomOf">@id/toolbar</item>
    </style>

    <style name="refresher">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="rv">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">@dimen/jumperListPad</item>
        <item name="fastScrollEnabled">true</item>
        <item name="fastScrollHorizontalThumbDrawable">@drawable/fast_scroll_thumb</item>
        <item name="fastScrollHorizontalTrackDrawable">@drawable/fast_scroll_line</item>
        <item name="fastScrollVerticalThumbDrawable">@drawable/fast_scroll_thumb</item>
        <item name="fastScrollVerticalTrackDrawable">@drawable/fast_scroll_line</item>
        <!-- all 4 are required, even if not used! -->
    </style>

    <style name="shimmer">
        <item name="shimmer_base_color">#66EEEEEE</item>
        <item name="shimmer_colored">true</item>
        <item name="shimmer_duration">700</item>
        <item name="shimmer_highlight_color">#66FFFFFF</item>
        <item name="shimmer_repeat_delay">50</item>
        <item name="shimmer_width_ratio">2</item>
    </style>

    <style name="shimmerIv">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/shimmerIvBg</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="more">
        <item name="android:layout_width">@dimen/moreAction</item>
        <item name="android:layout_height">@dimen/moreAction</item>
        <item name="android:background">@drawable/button_round</item>
        <item name="android:src">@drawable/more_vert</item>
        <item name="android:padding">13dp</item>
    </style>

    <style name="expandableButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:background">@drawable/button_round</item>
        <item name="android:padding">9dp</item>
    </style>

    <style name="simpleLoading" parent="parentConstraint">
        <item name="android:layout_width">@dimen/simpleLoading</item>
        <item name="android:layout_height">@dimen/simpleLoading</item>
        <item name="lottie_autoPlay">true</item>
        <item name="lottie_colorFilter">?android:colorAccent</item>
        <item name="lottie_loop">true</item>
        <item name="lottie_rawRes">@raw/loading</item>
    </style>

    <style name="simpleError" parent="parentConstraint">
        <item name="android:layout_width">@dimen/simpleError</item>
        <item name="android:layout_height">@dimen/simpleError</item>
        <item name="android:alpha">0.3</item>
        <item name="android:background">@drawable/button_round</item>
        <item name="android:src">@drawable/error</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="emptyList" parent="parentConstraint">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">15dp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">@dimen/emptyListFont</item>
        <item name="android:visibility">gone</item>
        <item name="layout_constraintWidth_percent">0.75</item>
    </style>

    <style name="jumper">
        <item name="android:layout_width">@dimen/jumperSize</item>
        <item name="android:layout_height">@dimen/jumperSize</item>
        <item name="android:layout_marginBottom">@dimen/jumperBottom</item>
        <item name="android:background">@drawable/button_round_bg</item>
        <item name="android:elevation">5dp</item>
        <!--<item name="android:importantForAccessibility">no</item>-->
        <item name="android:padding">@dimen/jumperPad</item>
        <item name="android:src">@drawable/up</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="tip" parent="parentConstraint">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:justificationMode">inter_word</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:textAlignment">center</item>
        <item name="layout_constraintWidth_percent">0.75</item>
    </style>

    <style name="dialogViewGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">5dp</item>
    </style>


    <!-- Main -->
    <style name="bnvButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/button</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAppearance">@style/TextAppearance.InstaTools.BNV.Inactive</item>
    </style>


    <!-- Downloads -->
    <style name="downloadsHelp">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
    </style>


    <!-- Viewer -->
    <style name="vwFlwCl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">0.5</item>
    </style>

    <style name="vwFlwLl" parent="parentConstraint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>

    <style name="vwFlwTv">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="vwFlwNum" parent="vwFlwTv">
        <item name="android:fontFamily">@font/bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="vwFlwText" parent="vwFlwTv">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/light</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="vwPager">
        <item name="android:layout_width">@dimen/vwPagerSize</item>
        <item name="android:layout_height">@dimen/vwPagerSize</item>
        <item name="android:layout_margin">@dimen/vwPagerMargin</item>
        <item name="android:background">@drawable/button_round_bg</item>
        <item name="android:elevation">5dp</item>
        <item name="android:padding">@dimen/vwPagerPad</item>
    </style>


    <!-- Settings -->
    <style name="stItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">@dimen/stPadH</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <style name="stItemName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/stItemName</item>
        <item name="android:paddingStart">@dimen/stStarter</item>
    </style>

    <style name="stSubItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:paddingHorizontal">@dimen/stStarter</item>
        <item name="android:textSize">@dimen/stSubItemFont</item>
    </style>

    <style name="stPath" parent="stSubItem">
        <item name="android:alpha">0.75</item>
        <item name="android:background">@drawable/path_selector</item>
        <item name="android:fontFamily">@font/light</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/defCA</item>
        <item name="android:textSize">@dimen/stPathFont</item>
    </style>

    <style name="stButton" parent="stSubItem">
        <item name="android:background">@drawable/st_button</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="stField" parent="stSubItem">
        <item name="android:background">@null</item>
    </style>

    <style name="stCheck">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:checked">false</item>
        <item name="android:visibility">gone</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
    </style>

    <style name="stSwitch">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?android:textColor</item>
        <item name="android:textSize">@dimen/stSubItemFont</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="stSpinner" parent="stSubItem">
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="stSep" parent="sep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginHorizontal">@dimen/stPadH</item>
        <item name="android:layout_marginVertical">@dimen/stMarginV</item>
    </style>
</resources>