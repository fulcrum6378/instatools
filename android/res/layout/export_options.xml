<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22sp"
        android:paddingTop="10dp"
        android:paddingEnd="22sp"
        android:paddingBottom="5dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/incImage"
            style="@style/expOptCheck"
            android:text="@string/expOptImage" />

        <RadioGroup
            android:id="@+id/quaImage"
            style="@style/expOptRadioGroup">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/quaImage0"
                style="@style/expOptRadio"
                android:text="@string/expOptLow" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/quaImage1"
                style="@style/expOptRadio"
                android:text="@string/expOptMed" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/quaImage2"
                style="@style/expOptRadio"
                android:text="@string/expOptHig" />
        </RadioGroup>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/incVideo"
            style="@style/expOptCheck"
            android:text="@string/expOptVideo" />

        <RadioGroup
            android:id="@+id/quaVideo"
            style="@style/expOptRadioGroup">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/quaVideo3"
                style="@style/expOptRadio"
                android:text="@string/expOptThm" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/quaVideo0"
                style="@style/expOptRadio"
                android:text="@string/expOptLow" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/quaVideo1"
                style="@style/expOptRadio"
                android:text="@string/expOptMed" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/quaVideo2"
                style="@style/expOptRadio"
                android:text="@string/expOptHig" />
        </RadioGroup>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/incVoice"
            style="@style/expOptCheck"
            android:text="@string/expOptVoice" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:alpha="0.8"
            android:background="@color/expOptSep" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.InstaTools.Light"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>