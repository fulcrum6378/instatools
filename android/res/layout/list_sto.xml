<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button"
        android:paddingHorizontal="@dimen/mainPadH"
        android:paddingVertical="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/vwHighlightCover"
            android:layout_height="@dimen/vwHighlightCover"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/reload"
            app:layout_constraintStart_toEndOf="@id/icon"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.InstaTools.Bold"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5sp"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextAppearance.InstaTools.Light"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/reload"
            android:layout_width="@dimen/favAction"
            android:layout_height="@dimen/favAction"
            android:background="@drawable/button_round"
            android:contentDescription="@string/reload"
            android:padding="15dp"
            android:src="@drawable/reload"
            android:tooltipText="@string/reload"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/downloadAll"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/downloadAll"
            android:layout_width="@dimen/favAction"
            android:layout_height="@dimen/favAction"
            android:background="@drawable/button_round"
            android:contentDescription="@string/downloadAll"
            android:padding="10dp"
            android:src="@drawable/download_all"
            android:tooltipText="@string/downloadAll"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vwReelHeight"
        android:background="#111"
        android:isScrollContainer="true"
        android:nestedScrollingEnabled="true"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/mainPadH"
        android:background="@color/sepLine"
        app:layout_constraintBottom_toBottomOf="@id/header" />
</androidx.constraintlayout.widget.ConstraintLayout>