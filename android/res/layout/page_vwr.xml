<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".frag.PageVwr"
    tools:ignore="ContentDescription,MissingConstraints">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresher"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="ir.mahdiparastesh.instatools.view.SafeGridManager"
            app:spanCount="3" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ImageView
        android:id="@+id/toPageRel"
        style="@style/vwPager"
        android:src="@drawable/metered_video"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/toPageTag"
        style="@style/vwPager"
        android:src="@drawable/tagged"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/jumper"
        style="@style/jumper" />
</androidx.constraintlayout.widget.ConstraintLayout>