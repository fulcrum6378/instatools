<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/root"
    tools:context=".Main">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="MissingConstraints">

        <android.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/toolbar"
            android:title="@string/app_name"
            android:titleMarginTop="@dimen/tbTitleMainMarginTop"
            android:titleTextAppearance="@style/TextAppearance.InstaTools.Toolbar.Main" />

        <FrameLayout
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bnv"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <View
            android:id="@+id/tbShadow"
            style="@style/tbShadow" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bnv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bnv"
            android:background="@color/defBG"
            android:saveEnabled="false"
            android:theme="@style/Theme.InstaTools.BNV"
            app:itemRippleColor="@color/defRipple"
            app:itemTextAppearanceActive="@style/TextAppearance.InstaTools.BNV.Active"
            app:itemTextAppearanceInactive="@style/TextAppearance.InstaTools.BNV.Inactive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:menu="@menu/main_bnv" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchRes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/defBG"
            android:orientation="vertical"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/bnv"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/searchStatus"
            android:layout_width="?android:actionBarSize"
            android:layout_height="?android:actionBarSize"
            android:alpha="0.4"
            android:padding="3dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/searchRes"
            app:layout_constraintLeft_toLeftOf="@id/searchRes"
            app:layout_constraintRight_toRightOf="@id/searchRes"
            app:layout_constraintTop_toTopOf="@id/searchRes"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/pending" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--<com.google.android.material.navigation.NavigationView
        android:id="@+id/nav"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/main_nav_header"
        app:itemRippleColor="@color/defRipple"
        app:itemTextAppearance="@style/TextAppearance.InstaTools.Nav"
        app:menu="@menu/main_nav" />-->

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?android:windowBackground"
        android:clickable="true"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/drwUserPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:id="@+id/drwLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/drawer_header"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="8dp"
                app:layout_constraintBottom_toBottomOf="@id/drwUserPhoto">

                <TextView
                    android:id="@+id/drwUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.InstaTools.Light"
                    android:textColor="@color/defCALight"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/drwUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textColor="@color/defCALight"
                    android:textSize="17sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ListView
            android:id="@+id/drwNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>