<resources>

    <style name="Theme.InstaTools" parent="Theme.InstaTools.Base">
        <item name="android:colorAccent">@color/defCA</item>
        <item name="colorPrimaryHigh">#99FFFFFF</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.InstaTools.Base.SingleColour" parent="Theme.InstaTools">
        <item name="backgroundColor">?android:colorPrimary</item>
    </style>

    <style name="Theme.InstaTools.Primary" parent="Theme.InstaTools.Base.SingleColour">
        <item name="android:colorPrimary">@color/CP</item>
        <item name="colorPrimaryWeak">@color/CPW</item>
        <item name="android:alertDialogTheme">@style/Theme.InstaTools.Dialog.Alert.Primary</item>
    </style>

    <style name="Theme.InstaTools.Secondary" parent="Theme.InstaTools.Base.SingleColour">
        <item name="android:colorPrimary">@color/CS</item>
        <item name="colorPrimaryWeak">@color/CSW</item>
        <item name="android:alertDialogTheme">@style/Theme.InstaTools.Dialog.Alert.Secondary</item>
    </style>

    <style name="Theme.InstaTools.Tertiary" parent="Theme.InstaTools.Base.SingleColour">
        <item name="android:colorPrimary">@color/CT</item>
        <item name="colorPrimaryWeak">@color/CTW</item>
        <item name="defCA">@color/defCA</item>
        <item name="android:alertDialogTheme">@style/Theme.InstaTools.Dialog.Alert.Tertiary</item>
    </style>


    <!-- AlertDialog -->
    <style name="Theme.InstaTools.Dialog.Alert" parent="android:Theme.DeviceDefault.Dialog.Alert"></style>

    <style name="Theme.InstaTools.Dialog.Alert.Primary" parent="Theme.InstaTools.Dialog.Alert">
        <item name="android:colorPrimaryDark">@color/defCA</item><!-- title text colour -->
        <item name="android:colorAccent">@color/defCA</item><!-- button text colour -->
    </style>

    <style name="Theme.InstaTools.Dialog.Alert.Secondary" parent="Theme.InstaTools.Dialog.Alert">
        <item name="android:colorPrimaryDark">@color/defCA</item>
        <item name="android:colorAccent">@color/defCA</item>
    </style>

    <style name="Theme.InstaTools.Dialog.Alert.Tertiary" parent="Theme.InstaTools.Dialog.Alert">
        <item name="android:colorPrimaryDark">@color/defCA</item>
        <item name="android:colorAccent">@color/defCA</item>
    </style>


    <!-- PopupMenu -->
    <style name="Widget.InstaTools.Popup" parent="android:Widget.DeviceDefault.PopupMenu">
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:textColor">?android:colorAccent</item>
        <item name="colorPrimaryWeak">@color/weakWhite</item>
        <item name="android:itemBackground">@drawable/menu_item</item>
    </style>

    <style name="Widget.InstaTools.Popup.Primary" parent="Widget.InstaTools.Popup">
        <item name="android:colorPrimary">@color/CP</item>
        <item name="android:colorAccent">@color/defCA</item>
    </style>

    <style name="Widget.InstaTools.Popup.Secondary" parent="Widget.InstaTools.Popup">
        <item name="android:colorPrimary">@color/CS</item>
        <item name="android:colorAccent">@color/defCA</item>
        <item name="android:itemBackground">@drawable/menu_item_secondary_night</item>
    </style>

    <style name="Widget.InstaTools.Popup.Tertiary" parent="Widget.InstaTools.Popup">
        <item name="android:colorPrimary">@color/CT</item>
        <item name="android:colorAccent">@color/defCA</item>
    </style>
</resources>