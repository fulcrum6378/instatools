<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/button"
    android:paddingLeft="@dimen/qudPadH"
    android:paddingRight="@dimen/qudPadH"
    tools:ignore="ContentDescription">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="@dimen/thumbPhoto"
        android:layout_height="@dimen/thumbPhoto"
        android:layout_marginStart="10dp"
        android:layout_marginTop="@dimen/qudPadV"
        android:layout_marginBottom="@dimen/qudPadV"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/user"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:textAlignment="viewStart"
        android:textColor="?attr/colorAccent"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/date"
        app:layout_constraintEnd_toStartOf="@id/status"
        app:layout_constraintStart_toEndOf="@id/thumb"
        app:layout_constraintTop_toTopOf="@id/thumb" />

    <TextView
        android:id="@+id/date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:textAlignment="viewStart"
        android:textColor="?attr/colorAccent"
        android:textDirection="ltr"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/thumb"
        app:layout_constraintEnd_toStartOf="@id/status"
        app:layout_constraintStart_toEndOf="@id/thumb"
        app:layout_constraintTop_toBottomOf="@id/user" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/status"
        android:layout_width="@dimen/thumbPhoto"
        android:layout_height="@dimen/thumbPhoto"
        android:background="@drawable/button_round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <View
        android:id="@+id/sep"
        style="@style/sep"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintWidth_percent="1" />
</androidx.constraintlayout.widget.ConstraintLayout>