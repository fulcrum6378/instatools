<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="-90"
                android:type="linear"
                android:centerX="0.65"
                android:endColor="@color/CT"
                android:startColor="@color/CS" />
            <!-- startColor is intrinsically at left  -->
            <!--   endColor is intrinsically at right -->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="225"
                android:centerX="0.35"
                android:centerY="0.75"
                android:centerColor="#33FF7553"
                android:endColor="#FF481B"
                android:startColor="@color/tp" />
        </shape>
    </item>
</layer-list>