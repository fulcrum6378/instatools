<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="root">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layoutDirection">ltr</item>
    </style>

    <style name="parentConstraint">
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
    </style>

    <style name="toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?actionBarSize</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="popupTheme">@style/Widget.MaterialComponents.PopupMenu</item>
        <item name="titleTextColor">?attr/colorAccent</item>
        <item name="titleTextAppearance">@style/Theme.InstaTools.Toolbar</item>
    </style>

    <style name="sep">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:alpha">0.12</item>
        <item name="android:background">?attr/colorAccent</item>
    </style>

    <style name="shadow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:background">@drawable/shadow</item>
        <item name="android:alpha">0.6</item>
    </style>

    <style name="tbShadow" parent="shadow">
        <item name="android:visibility">invisible</item>
        <item name="layout_constraintTop_toBottomOf">@id/toolbar</item>
    </style>

    <style name="refresher">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="rv">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="shimmer">
        <item name="shimmer_base_color">#66EEEEEE</item>
        <item name="shimmer_colored">true</item>
        <item name="shimmer_duration">700</item>
        <item name="shimmer_highlight_color">#66FFFFFF</item>
        <item name="shimmer_repeat_delay">50</item>
        <item name="shimmer_width_ratio">2</item>
    </style>

    <style name="shimmerIv">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/shimmerIvBg</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="more">
        <item name="android:layout_width">@dimen/moreAction</item>
        <item name="android:layout_height">@dimen/moreAction</item>
        <item name="android:padding">13dp</item>
        <item name="android:background">@drawable/button_round</item>
        <item name="android:src">@drawable/more_vert</item>
    </style>

    <style name="expanded">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:visibility">invisible</item>
    </style>

    <style name="expandedSlider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="expandedIndicator">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:visibility">gone</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="dotsColor">?attr/colorAccent</item>
        <item name="dotsCornerRadius">6dp</item>
        <item name="dotsSize">12dp</item>
        <item name="dotsSpacing">3dp</item>
        <item name="dotsWidthFactor">2.5</item>
        <item name="progressMode">true</item>
        <item name="selectedDotColor">?attr/colorAccent</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="expandableButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:background">@drawable/button_round</item>
    </style>

    <style name="simpleLoading" parent="parentConstraint">
        <item name="android:layout_width">@dimen/simpleLoading</item>
        <item name="android:layout_height">@dimen/simpleLoading</item>
        <item name="lottie_colorFilter">?attr/colorAccent</item>
        <item name="lottie_rawRes">@raw/loading</item>
        <item name="lottie_autoPlay">true</item>
        <item name="lottie_loop">true</item>
    </style>

    <style name="simpleError" parent="parentConstraint">
        <item name="android:layout_width">@dimen/simpleError</item>
        <item name="android:layout_height">@dimen/simpleError</item>
        <item name="android:src">@drawable/error</item>
        <item name="android:alpha">0.3</item>
        <item name="android:visibility">gone</item>
        <item name="android:background">@drawable/button_round</item>
    </style>

    <style name="emptyList" parent="parentConstraint">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">15dp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:visibility">gone</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textSize">@dimen/emptyListFont</item>
        <item name="layout_constraintWidth_percent">0.75</item>
    </style>

    <style name="jumper">
        <item name="android:layout_width">@dimen/jumperSize</item>
        <item name="android:layout_height">@dimen/jumperSize</item>
        <item name="android:padding">@dimen/jumperPad</item>
        <item name="android:src">@drawable/up</item>
        <item name="android:background">@drawable/button_round_bg</item>
        <item name="android:elevation">5dp</item>
        <item name="android:layout_marginBottom">@dimen/jumperBottom</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
    </style>

    <style name="tip" parent="parentConstraint">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:justificationMode" tools:ignore="NewApi">inter_word</item>
        <item name="layout_constraintWidth_percent">0.75</item>
    </style>

    <style name="payForItItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/button</item>
        <item name="android:paddingTop">15sp</item>
        <item name="android:paddingBottom">15sp</item>
        <item name="android:paddingStart">20sp</item>
        <item name="android:paddingEnd">20sp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="payForItItemIv">
        <item name="android:layout_width">@dimen/mfPayForItIcon</item>
        <item name="android:layout_height">@dimen/mfPayForItIcon</item>
    </style>

    <style name="payForItItemTvLl">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10sp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="payForItItemTv">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorAccent</item>
    </style>

    <style name="payForItItemTv1" parent="payForItItemTv">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="payForItItemTv2" parent="payForItItemTv">
        <item name="android:textSize">15sp</item>
    </style>


    <!-- Downloads -->
    <style name="downloadsHelp">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textColor">?attr/colorAccent</item>
    </style>


    <!-- Mass Follower -->
    <style name="mfGuideTv">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:justificationMode" tools:ignore="NewApi">inter_word</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_marginTop">36sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:textSize">@dimen/mfGuideTv</item>
    </style>


    <!-- Viewer -->
    <style name="vwFlwCl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">0.5</item>
        <item name="android:background">@drawable/button</item>
    </style>

    <style name="vwFlwLl" parent="parentConstraint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>

    <style name="vwFlwTv">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="vwFlwNum" parent="vwFlwTv">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="vwFlwText" parent="vwFlwTv">
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>


    <!-- Settings -->
    <style name="stItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingLeft">@dimen/stPadH</item>
        <item name="android:paddingRight">@dimen/stPadH</item>
    </style>

    <style name="stItemName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/stItemName</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:paddingStart">@dimen/stStarter</item>
        <!--<item name="android:drawableStart">@drawable/settings</item>
        <item name="android:drawablePadding">10dp</item>-->
    </style>

    <style name="stSubItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:paddingLeft">@dimen/stStarter</item>
        <item name="android:paddingRight">@dimen/stStarter</item>
        <item name="android:textSize">@dimen/stSubItemFont</item>
        <item name="android:textColor">?attr/colorAccent</item>
    </style>

    <style name="stPath" parent="stSubItem">
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/path_selector</item>
        <item name="android:textSize">@dimen/stPathFont</item>
        <item name="android:textColor">@color/defCA</item>
        <item name="android:alpha">0.75</item>
    </style>

    <style name="stButton" parent="stSubItem">
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/st_button</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="stSep" parent="sep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginLeft">@dimen/stPadH</item>
        <item name="android:layout_marginRight">@dimen/stPadH</item>
        <item name="android:layout_marginTop">@dimen/stMarginV</item>
        <item name="android:layout_marginBottom">@dimen/stMarginV</item>
    </style>
</resources>