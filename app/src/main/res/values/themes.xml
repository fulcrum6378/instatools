<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.InstaTools" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/defCA</item>
        <item name="colorPrimaryDark">@color/defCA</item>
        <item name="colorAccent">?attr/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/defBG</item>
        <item name="android:navigationBarColor">@color/defBG</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <!--<item name="android:windowTranslucentNavigation">true</item>-->
    </style>

    <style name="Theme.InstaTools.Primary" parent="Theme.InstaTools">
        <item name="colorPrimary">@color/CP</item>
        <item name="colorPrimaryDark">@color/CPD</item>
    </style>

    <style name="Theme.InstaTools.Secondary" parent="Theme.InstaTools">
        <item name="colorPrimary">@color/CS</item>
        <item name="colorPrimaryDark">@color/CSD</item>
    </style>

    <style name="Theme.InstaTools.Tertiary" parent="Theme.InstaTools">
        <item name="colorPrimary">@color/CT</item>
        <item name="colorPrimaryDark">@color/CTD</item>
    </style>
</resources>