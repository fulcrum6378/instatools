<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ir.mahdiparastesh.instatools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/new_backup"
        android:fullBackupContent="@xml/old_backup"
        android:icon="@mipmap/launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstaTools"
        tools:ignore="UnusedAttribute">

        <activity
            android:name=".Main"
            android:exported="true"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Login"
            android:exported="false"
            android:theme="@style/Theme.InstaTools.Secondary"
            android:windowSoftInputMode="stateHidden|adjustPan" />

        <activity
            android:name=".Downloads"
            android:exported="true"
            android:launchMode="singleTask"
            android:parentActivityName=".Main"
            android:theme="@style/Theme.InstaTools.Secondary">

            <intent-filter android:label="@string/dwShare">
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Viewer"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.InstaTools.Secondary">

            <intent-filter android:label="@string/vwShare">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="www.instagram.com"
                    android:scheme="https" />

                <data
                    android:host="instagram.com"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Favourites"
            android:exported="false"
            android:parentActivityName=".Main"
            android:theme="@style/Theme.InstaTools.Primary" />

        <activity
            android:name=".MassFollower"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".Main"
            android:theme="@style/Theme.InstaTools.Primary" />

        <activity
            android:name=".Settings"
            android:exported="false"
            android:parentActivityName=".Main"
            android:theme="@style/Theme.InstaTools.Tertiary" />

        <service
            android:name=".serv.Queuer"
            android:exported="false"
            android:stopWithTask="false" />

        <service
            android:name=".serv.Exporter"
            android:exported="false"
            android:stopWithTask="false" />

        <service
            android:name=".serv.Follower"
            android:exported="false"
            android:stopWithTask="false" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/app_ad_id" />
    </application>
</manifest>